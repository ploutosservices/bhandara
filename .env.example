# Every setting the service reads. The values are the compose demo's; outside it, export your own.

# Required. libpq connection string for the metadata database (schema.sql).
STORAGE_DB_DSN=host=postgres dbname=storage user=storage

# The default backend: any S3-compatible store. MINIO_URL defaults to http://localhost:9000 and
# MINIO_BUCKET to "storage"; the access key and secret are required (the demo's store accepts any).
# The bucket must exist.
MINIO_URL=http://s3:8333
MINIO_ACCESS_KEY=demo-access-key
MINIO_SECRET_KEY=CHANGEME
MINIO_BUCKET=storage

# Optional. Named backends beyond the default, as JSON:
#   {"<name>": {"endpoint_url": "...", "access_key": "...", "secret_key": "...", "bucket": "..."}}
# Bucket names must be unique across backends. Default: {} (one backend).
STORAGE_BACKENDS_JSON={}

# Optional. A URL answering {"rows": [{"_key": "<tenant>", "storage_destination": "<backend>"}]},
# read on every call that sends tenant= instead of destination=. Unset: tenant= is refused, 503.
STORAGE_TENANT_LOOKUP_URL=

# Optional. The header your mTLS proxy sets from the verified certificate's subject.
# Default: X-Client-Identity.
STORAGE_IDENTITY_HEADER=X-Client-Identity

# Optional. The application name of the operator identity, which alone may run gc and release any
# non-production scope. Default: infra-ops.
STORAGE_OPERATOR_APP=infra-ops
